.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.env

# Generated data is reproducible from the seed; only Mwila's demo files are kept.
data/synthetic/*
!data/synthetic/transactions/
!data/synthetic/statements/
data/synthetic/transactions/*
data/synthetic/statements/*
!data/synthetic/transactions/MWILA-001_*
!data/synthetic/statements/MWILA-001_*

# Cached Qwen labels are kept (synthetic clients only), so the deployed demo needs no
# model calls; memo drafts only for Mwila.
data/memos/*
!data/memos/MWILA-001*

# The risk model's training cohort (seed 43) is regenerated on demand.
data/training/

# Agent runs and case files: only Mwila's demo case is kept.
data/agent/*
!data/agent/MWILA-001.json
data/cases/*
!data/cases/MWILA-001*

# Front-end dependencies and build output (npm install; npm run build).
frontend/node_modules/
frontend/dist/

# Statements customers or RMs upload: never committed.
data/uploads/
